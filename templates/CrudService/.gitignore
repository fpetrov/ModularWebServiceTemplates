## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add‑ons.
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# MonoDevelop/Xamarin Studio
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Aa][Rr][Mm]64[Ee][Cc]/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Build results on 'Bin' directories
**/[Bb]in/*

# Uncomment if you have tasks that rely on *.refresh files to move binaries
#!**/[Bb]in/*.refresh

# Visual Studio workspace cache/options directory
.vs/

# Visual Studio 2017 auto generated files
Generated\ Files/

# Test results
[Tt]est[Rr]esult*/ 
[Bb]uild[Ll]og.* 
*.trx

# Coverage & benchmarks
BenchmarkDotNet.Artifacts/
*.coverage
*.coveragexml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages & project.json
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Azure
PublishScripts/
*.azurePubxml
*.publishsettings

# Rider & ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Others (logs, temp, backups, tools, etc.)
*.log
*.tlog
*.tmp
*.tmp_proj
*.cachefile
backup*/ 
UpgradeLog*.*
*.dbmdl
*.mdf
*.ldf
*.ndf

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# Add your custom ignores below
CrudService.SourceGenerator/
CrudService.SourceGenerator.SharedAssets/
CrudService.sln.DotSettings.user

.idea/
.DS_Store
