{
  "$schema": "http://json.schemastore.org/template",
  "identity": "BotServiceModule.Project",
  "name": "BotServiceModule Project",
  "author": "Fedor Petrov",
  "description": "A Telegram bot service.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "preferNameDirectory": true,
  "shortName": "bot",
  "sourceName": "BotServiceModule",
  "groupIdentity": "BotServiceModule.Templates",
  "classifications": [
    "Webhook",
    "Polling"
  ],
  "symbols": {
    "BotType": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "Polling" },
        { "choice": "Webhook" }
      ],
      "defaultValue": "Polling",
      "enableQuotelessLiterals": true
    },
    "IsPolling": { "type": "computed", "value": "BotType == Polling" },
    "IsWebhook": { "type": "computed", "value": "BotType == Webhook" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**",
        "Nuget.config",
        ".idea/**"
      ],
      "modifiers": [
        {
          "condition": "IsPolling",
          "exclude": [
            "Controllers/**",
            "BotServiceModuleWebhookService.cs"
          ]
        },
        {
          "condition": "IsWebhook",
          "exclude": [
            "BotServiceModulePollingService.cs"
          ]
        }
      ]
    }
  ]
}